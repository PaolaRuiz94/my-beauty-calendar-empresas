rules_version = '2';

// Este bucket lo comparten las dos apps (ver firestore.rules para el detalle
// completo del modelo compartido).
//
// Rutas de la app consumidora (repo hermano my-beauty-calendar, por grep):
//   progress_photos/{uid}/{archivo}   - fotos privadas de progreso (progressPhotos.js)
//   forum_posts/{uid}/{archivo}       - imágenes adjuntas a publicaciones del foro (posts.js)
//   profile_photos/{archivo}          - foto de perfil (ProfileScreen.js)
//
// Rutas de este repo (mycalendarbeauty-empresas):
//   peluquerias/{storeId}/products/{archivo}   - fotos de producto (Products.jsx)
//   peluquerias/{storeId}/servicios/{archivo}  - fotos de servicio (Services.jsx)
//
// NOTA sobre profile_photos: el nombre de archivo se deriva del email
// (userEmail.replace('@','_').replace('.','_')), no del uid. El lenguaje de
// reglas de Storage no tiene funciones de string para reproducir esa
// transformación, así que no se puede validar que el archivo pertenece
// exactamente a quien lo sube — solo se exige estar autenticada. Lo más
// prolijo sería cambiar esa ruta a `profile_photos/{uid}` en el código de la
// app consumidora, para poder cerrarla igual que progress_photos/forum_posts.
service firebase.storage {
  match /b/{bucket}/o {

    match /progress_photos/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /forum_posts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /profile_photos/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Las fotos de producto/servicio se muestran con la download URL con
    // token que devuelve getDownloadURL(), que es públicamente legible sin
    // pasar por esta regla (así funciona Storage) — read acá solo cubre
    // accesos directos por el SDK. La escritura sí queda atada a la dueña de
    // la tienda, comparando contra el mismo ownerId que usa firestore.rules.
    match /peluquerias/{storeId}/products/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/peluquerias/$(storeId)).data.ownerId == request.auth.uid;
    }

    match /peluquerias/{storeId}/servicios/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/peluquerias/$(storeId)).data.ownerId == request.auth.uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
